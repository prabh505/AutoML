def target_column(frame: pd.DataFrame, name: str) -> str:
    """Accept the target under its original or normalized name."""
    for candidate in (name, TARGET, TARGET_ORIGINAL):
        if candidate in frame.columns:
            return candidate
    raise SystemExit(f"target column {name!r} is not in the file")


def encode_target(values: pd.Series) -> np.ndarray:
    """Regression: floats. Classification: codes in CLASSES order (as during training)."""
    if TASK == "regression":
        return pd.to_numeric(values, errors="raise").to_numpy(dtype=np.float64)
    codes = {label: i for i, label in enumerate(CLASSES)}
    mapped = values.astype("string").map(codes)
    if mapped.isna().any():
        raise SystemExit("the target has labels that the exported model does not know")
    return mapped.to_numpy(dtype=np.int64)


def train(args: argparse.Namespace) -> int:
    from tabpilot_runtime.bundle import read_table

    frame = read_table(args.data)
    target = target_column(frame, args.target)
    frame = frame[frame[target].notna()].reset_index(drop=True)
    if args.resplit:
        split = json.loads((HERE / "metadata" / "experiment.json").read_text("utf-8"))["split"]
        if len(frame) != split["n_rows_valid"]:
            raise SystemExit("this file does not match the training file (row count differs)")
        frame = frame.iloc[split["dev_positions"]].reset_index(drop=True)
    model = build_model().fit(frame.drop(columns=[target]), encode_target(frame[target]))
    joblib.dump(model, args.out, protocol=JOBLIB_PROTOCOL)
    print(f"trained on {len(frame)} rows -> {args.out}")
    return 0


def predict(args: argparse.Namespace) -> int:
    from tabpilot_runtime.bundle import predict_outputs, read_table, write_predictions

    model = joblib.load(args.model)
    frame = read_table(args.input)
    write_predictions(args.out, predict_outputs(model, frame, TASK, CLASSES), CLASSES)
    print(f"wrote {len(frame)} predictions -> {args.out}")
    return 0


def verify_bundle(args: argparse.Namespace) -> int:
    from tabpilot_runtime.bundle import verify

    report = verify(HERE, joblib.load(HERE / "model" / "model.joblib"))
    status = "PASSED" if report.ok else "FAILED"
    print(f"R1 parity {status}: {report.rows} rows, label mismatches {report.label_mismatches}, "
          f"max |diff| {report.max_abs_diff:.3e}")
    return 0 if report.ok else 1


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=f"TabPilot pipeline for run {RUN_ID}")
    sub = parser.add_subparsers(dest="command", required=True)
    tr = sub.add_parser("train", help="refit the exported configuration")
    tr.add_argument("--data", required=True)
    tr.add_argument("--target", default=TARGET_ORIGINAL)
    tr.add_argument("--out", required=True)
    tr.add_argument("--resplit", action="store_true")
    pr = sub.add_parser("predict", help="predict on a CSV")
    pr.add_argument("--model", default=str(HERE / "model" / "model.joblib"))
    pr.add_argument("--input", required=True)
    pr.add_argument("--out", required=True)
    sub.add_parser("verify", help="check R1 prediction parity")
    args = parser.parse_args(argv)
    handlers = {"train": train, "predict": predict, "verify": verify_bundle}
    return handlers[args.command](args)


if __name__ == "__main__":
    raise SystemExit(main())
