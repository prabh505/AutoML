"""Standalone TabPilot pipeline for run {{ run_id }}.

Generated by TabPilot's exporter from a fixed template (never by an LLM). It needs only the
packages in requirements.txt and the bundled `tabpilot_runtime/` package next to this file.

SECURITY WARNING: joblib/pickle files can execute arbitrary code when loaded. Only load model
files from sources you trust.

Commands (run from the bundle directory):
    python pipeline.py verify
        Reload model/model.joblib and check it reproduces parity/parity_expected.json (R1).
    python pipeline.py predict --model model/model.joblib --input new.csv --out preds.csv
        Predict on a CSV with the original (or normalized) column names.
    python pipeline.py train --data dev.csv --out model.joblib [--target COLUMN] [--resplit]
        Refit the exported configuration (same steps, hyperparameters and seeds) on the rows you
        supply, which should be the development (DEV) rows. With --resplit, pass the full file
        you uploaded instead: rows with a missing target are dropped and the recorded DEV row
        positions are selected, recreating the original split (the holdout rows stay unused).
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Any

