TASK = {{ task }}
TARGET = {{ target }}
TARGET_ORIGINAL = {{ target_original }}
CLASSES = {{ classes }}
SEEDS = {{ seeds }}
JOBLIB_PROTOCOL = 5


def build_model() -> Any:
