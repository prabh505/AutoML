{
  "schema_version": "plan/1.0",
  "column_decisions": [
    {
      "column": "num_support_calls",
      "action": "treat_as_categorical",
      "reason": "Few distinct integer values."
    }
  ],
  "imputation": {
    "numeric": "median",
    "categorical": "most_frequent",
    "add_missing_indicators": true
  },
  "encoding": {
    "low_cardinality": "onehot",
    "high_cardinality": "frequency"
  },
  "features": [
    {
      "id": "f01",
      "name": "charges_per_month_tenure",
      "op": "ratio",
      "inputs": [
        "monthly_charges",
        "tenure_months"
      ],
      "params": {
        "eps": 1e-06
      },
      "rationale": "Spend relative to tenure."
    },
    {
      "id": "f02",
      "name": "contract_mean_charges",
      "op": "group_mean",
      "inputs": [
        "contract",
        "monthly_charges"
      ],
      "rationale": "Contract pricing."
    }
  ],
  "models": [
    {
      "name": "xgboost",
      "priority": 1
    },
    {
      "name": "lightgbm",
      "priority": 2
    }
  ],
  "tuning_allocation": {
    "xgboost": 0.5,
    "lightgbm": 0.5
  },
  "target_transform": "none",
  "cv_folds": 5,
  "metric_recommendation": "roc_auc",
  "rationale": "Contract and tenure dominate churn."
}
