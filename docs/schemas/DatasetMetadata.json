{
  "$defs": {
    "ColumnInfo": {
      "additionalProperties": false,
      "description": "One column's normalized name, type, role, and data decisions (FR-ING-03, FR-ING-04).",
      "properties": {
        "coerced_to_missing": {
          "default": 0,
          "minimum": 0,
          "title": "Coerced To Missing",
          "type": "integer"
        },
        "dtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dtype"
        },
        "exclusion_reason": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclusion Reason"
        },
        "hints": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Hints",
          "type": "array"
        },
        "missing_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Rate"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,79}$",
          "title": "Name",
          "type": "string"
        },
        "original": {
          "maxLength": 1000,
          "title": "Original",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ColumnRole"
        },
        "semantic_type": {
          "$ref": "#/$defs/SemanticType"
        }
      },
      "required": [
        "original",
        "name",
        "semantic_type",
        "role"
      ],
      "title": "ColumnInfo",
      "type": "object"
    },
    "ColumnRole": {
      "description": "Column roles (FR-ING-04).",
      "enum": [
        "feature",
        "target",
        "excluded",
        "group"
      ],
      "title": "ColumnRole",
      "type": "string"
    },
    "RowRemoval": {
      "additionalProperties": false,
      "description": "A recorded row removal (no-silent-discard rule, PRD §8.6).",
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "reason": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "count"
      ],
      "title": "RowRemoval",
      "type": "object"
    },
    "SemanticType": {
      "description": "Column semantic types (FR-ING-04, §8.5).",
      "enum": [
        "numeric",
        "categorical",
        "boolean",
        "datetime",
        "text",
        "identifier",
        "constant"
      ],
      "title": "SemanticType",
      "type": "string"
    },
    "SourceInfo": {
      "additionalProperties": false,
      "description": "Uploaded file facts. `display_name` is sanitized display text only (PRD §24.2).",
      "properties": {
        "delimiter": {
          "anyOf": [
            {
              "maxLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delimiter"
        },
        "display_name": {
          "maxLength": 120,
          "title": "Display Name",
          "type": "string"
        },
        "encoding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encoding"
        },
        "format": {
          "enum": [
            "csv",
            "tsv",
            "txt",
            "parquet"
          ],
          "title": "Format",
          "type": "string"
        },
        "malformed_lines_skipped": {
          "default": 0,
          "minimum": 0,
          "title": "Malformed Lines Skipped",
          "type": "integer"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "display_name",
        "format",
        "size_bytes"
      ],
      "title": "SourceInfo",
      "type": "object"
    },
    "TargetInfo": {
      "additionalProperties": false,
      "description": "Target summary stored in `DatasetMetadata`.",
      "properties": {
        "class_counts": {
          "anyOf": [
            {
              "additionalProperties": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Class Counts"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "positive_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Positive Label"
        },
        "task": {
          "anyOf": [
            {
              "$ref": "#/$defs/Task"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "title": "TargetInfo",
      "type": "object"
    },
    "Task": {
      "description": "Supported prediction tasks (PRD §2.2, §10.1).",
      "enum": [
        "binary",
        "multiclass",
        "regression"
      ],
      "title": "Task",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Dataset metadata (`dataset/1.0`, PRD §26.1).",
  "properties": {
    "columns": {
      "items": {
        "$ref": "#/$defs/ColumnInfo"
      },
      "title": "Columns",
      "type": "array"
    },
    "n_columns": {
      "minimum": 0,
      "title": "N Columns",
      "type": "integer"
    },
    "n_rows_raw": {
      "minimum": 0,
      "title": "N Rows Raw",
      "type": "integer"
    },
    "n_rows_valid": {
      "minimum": 0,
      "title": "N Rows Valid",
      "type": "integer"
    },
    "row_removals": {
      "items": {
        "$ref": "#/$defs/RowRemoval"
      },
      "title": "Row Removals",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "dataset/1.0",
      "default": "dataset/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceInfo"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/TargetInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "source",
    "n_rows_raw",
    "n_rows_valid",
    "n_columns",
    "columns"
  ],
  "title": "DatasetMetadata",
  "type": "object",
  "x-schema-version": "dataset/1.0"
}
