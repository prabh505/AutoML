        "rejected"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "estimated_peak_mb",
    "limit_mb"
  ],
  "title": "FeasibilityReport",
  "type": "object",
  "x-schema-version": "feasibility/1.0"
