{
  "$defs": {
    "AddFeatures": {
      "additionalProperties": false,
      "description": "Add ≤ 6 new DSL features (PRD §19.3).",
      "properties": {
        "features": {
          "items": {
            "discriminator": {
              "mapping": {
                "add": "#/$defs/BinaryArithmeticSpec",
                "bin_quantile": "#/$defs/BinQuantileSpec",
                "clip": "#/$defs/ClipSpec",
                "concat_categories": "#/$defs/ConcatCategoriesSpec",
                "count_missing": "#/$defs/RowAggregateSpec",
                "date_diff_days": "#/$defs/DateDiffSpec",
                "equals": "#/$defs/EqualsSpec",
                "group_count": "#/$defs/GroupCountSpec",
                "group_deviation": "#/$defs/GroupStatSpec",
                "group_mean": "#/$defs/GroupStatSpec",
                "group_std": "#/$defs/GroupStatSpec",
                "is_missing": "#/$defs/IsMissingSpec",
                "log1p": "#/$defs/UnaryNumericSpec",
                "multiply": "#/$defs/BinaryArithmeticSpec",
                "ratio": "#/$defs/RatioSpec",
                "row_mean": "#/$defs/RowAggregateSpec",
                "row_sum": "#/$defs/RowAggregateSpec",
                "sqrt": "#/$defs/UnaryNumericSpec",
                "square": "#/$defs/UnaryNumericSpec",
                "subtract": "#/$defs/BinaryArithmeticSpec"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/BinaryArithmeticSpec"
              },
              {
                "$ref": "#/$defs/RatioSpec"
              },
              {
                "$ref": "#/$defs/UnaryNumericSpec"
              },
              {
                "$ref": "#/$defs/ClipSpec"
              },
              {
                "$ref": "#/$defs/BinQuantileSpec"
              },
              {
                "$ref": "#/$defs/IsMissingSpec"
              },
              {
                "$ref": "#/$defs/EqualsSpec"
              },
              {
                "$ref": "#/$defs/RowAggregateSpec"
              },
              {
                "$ref": "#/$defs/ConcatCategoriesSpec"
              },
              {
                "$ref": "#/$defs/GroupStatSpec"
              },
              {
                "$ref": "#/$defs/GroupCountSpec"
              },
              {
                "$ref": "#/$defs/DateDiffSpec"
              }
            ]
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Features",
          "type": "array"
        },
        "type": {
          "const": "add_features",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "features"
      ],
      "title": "AddFeatures",
      "type": "object"
    },
    "BinQuantileParams": {
      "additionalProperties": false,
      "description": "`bin_quantile`: number of bins 2–20 (PRD §14.3).",
      "properties": {
        "n_bins": {
          "maximum": 20,
          "minimum": 2,
          "title": "N Bins",
          "type": "integer"
        }
      },
      "required": [
        "n_bins"
      ],
      "title": "BinQuantileParams",
      "type": "object"
    },
    "BinQuantileSpec": {
      "additionalProperties": false,
      "description": "`bin_quantile`: 1 numeric input → categorical; stateful.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,15}$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,59}$",
          "title": "Name",
          "type": "string"
        },
        "op": {
          "const": "bin_quantile",
          "title": "Op",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/BinQuantileParams"
        },
        "rationale": {
          "default": "",
          "maxLength": 300,
          "title": "Rationale",
          "type": "string"
        },
        "schema_version": {
          "const": "feature_spec/1.0",
          "default": "feature_spec/1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "op",
        "inputs",
        "params"
      ],
      "title": "BinQuantileSpec",
      "type": "object"
    },
    "BinaryArithmeticSpec": {
      "additionalProperties": false,
      "description": "`add`, `subtract`, `multiply`: 2 numeric inputs.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,15}$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Inputs",
          "type": "array"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,59}$",
          "title": "Name",
          "type": "string"
        },
        "op": {
          "enum": [
            "add",
            "subtract",
            "multiply"
          ],
          "title": "Op",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/NoParams"
        },
        "rationale": {
          "default": "",
          "maxLength": 300,
          "title": "Rationale",
          "type": "string"
        },
        "schema_version": {
          "const": "feature_spec/1.0",
          "default": "feature_spec/1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "op",
        "inputs"
      ],
      "title": "BinaryArithmeticSpec",
      "type": "object"
    },
    "ChangeEncoding": {
      "additionalProperties": false,
      "description": "Change encoding for named columns within the allowed encodings (PRD §19.3).",
      "properties": {
        "columns": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "encoding": {
          "enum": [
            "onehot",
            "ordinal",
            "frequency",
            "target"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "type": {
          "const": "change_encoding",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "columns",
        "encoding"
      ],
      "title": "ChangeEncoding",
      "type": "object"
    },
    "ChangeTargetTransform": {
      "additionalProperties": false,
      "description": "Regression only: none ↔ log1p (PRD §19.3).",
      "properties": {
        "type": {
          "const": "change_target_transform",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/TargetTransform"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "ChangeTargetTransform",
      "type": "object"
    },
    "ClassWeight": {
      "description": "Class-weight setting for classification models (PRD §12.3, §16.2).",
      "enum": [
        "none",
        "balanced"
      ],
      "title": "ClassWeight",
      "type": "string"
    },
    "ClipParams": {
      "additionalProperties": false,
      "description": "`clip`: quantile bounds learned per fold (PRD §14.3).",
      "properties": {
        "lower_q": {
          "maximum": 0.2,
          "minimum": 0.0,
          "title": "Lower Q",
          "type": "number"
        },
        "upper_q": {
          "maximum": 1.0,
          "minimum": 0.8,
          "title": "Upper Q",
          "type": "number"
        }
      },
      "required": [
        "lower_q",
        "upper_q"
      ],
      "title": "ClipParams",
      "type": "object"
    },
    "ClipSpec": {
      "additionalProperties": false,
