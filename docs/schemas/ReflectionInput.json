{
  "$defs": {
    "BinQuantileParams": {
      "additionalProperties": false,
      "description": "`bin_quantile`: number of bins 2–20 (PRD §14.3).",
      "properties": {
        "n_bins": {
          "maximum": 20,
          "minimum": 2,
          "title": "N Bins",
          "type": "integer"
        }
      },
      "required": [
        "n_bins"
      ],
      "title": "BinQuantileParams",
      "type": "object"
    },
    "BinQuantileSpec": {
      "additionalProperties": false,
      "description": "`bin_quantile`: 1 numeric input → categorical; stateful.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,15}$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,59}$",
          "title": "Name",
          "type": "string"
        },
        "op": {
          "const": "bin_quantile",
          "title": "Op",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/BinQuantileParams"
        },
        "rationale": {
          "default": "",
          "maxLength": 300,
          "title": "Rationale",
          "type": "string"
        },
        "schema_version": {
          "const": "feature_spec/1.0",
          "default": "feature_spec/1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "op",
        "inputs",
        "params"
      ],
      "title": "BinQuantileSpec",
      "type": "object"
    },
    "BinaryArithmeticSpec": {
