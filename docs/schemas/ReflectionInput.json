    "FeatureImportance": {
      "additionalProperties": false,
      "description": "Normalized importance of a **source** column (PRD §19.2; PI-16: no one-hot labels).",
      "properties": {
        "importance": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Importance",
          "type": "number"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "importance"
      ],
      "title": "FeatureImportance",
      "type": "object"
    },
    "FeatureProvenance": {
      "additionalProperties": false,
      "description": "Provenance of one feature (`feature_provenance/1.0`, PRD §14.6).",
      "properties": {
        "cv_contribution": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cv Contribution"
        },
        "failure_reason": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Reason"
        },
        "id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "iteration": {
          "maximum": 2,
          "minimum": 0,
          "title": "Iteration",
          "type": "integer"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "feature_provenance/1.0",
          "default": "feature_provenance/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "enum": [
            "llm_plan",
            "llm_reflection",
            "baseline"
          ],
          "title": "Source",
          "type": "string"
        },
        "spec": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "add": "#/$defs/BinaryArithmeticSpec",
                  "bin_quantile": "#/$defs/BinQuantileSpec",
                  "clip": "#/$defs/ClipSpec",
                  "concat_categories": "#/$defs/ConcatCategoriesSpec",
                  "count_missing": "#/$defs/RowAggregateSpec",
                  "date_diff_days": "#/$defs/DateDiffSpec",
                  "equals": "#/$defs/EqualsSpec",
                  "group_count": "#/$defs/GroupCountSpec",
                  "group_deviation": "#/$defs/GroupStatSpec",
                  "group_mean": "#/$defs/GroupStatSpec",
                  "group_std": "#/$defs/GroupStatSpec",
                  "is_missing": "#/$defs/IsMissingSpec",
                  "log1p": "#/$defs/UnaryNumericSpec",
                  "multiply": "#/$defs/BinaryArithmeticSpec",
                  "ratio": "#/$defs/RatioSpec",
                  "row_mean": "#/$defs/RowAggregateSpec",
                  "row_sum": "#/$defs/RowAggregateSpec",
                  "sqrt": "#/$defs/UnaryNumericSpec",
                  "square": "#/$defs/UnaryNumericSpec",
                  "subtract": "#/$defs/BinaryArithmeticSpec"
                },
                "propertyName": "op"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/BinaryArithmeticSpec"
                },
                {
                  "$ref": "#/$defs/RatioSpec"
                },
                {
                  "$ref": "#/$defs/UnaryNumericSpec"
                },
                {
                  "$ref": "#/$defs/ClipSpec"
                },
                {
                  "$ref": "#/$defs/BinQuantileSpec"
                },
                {
                  "$ref": "#/$defs/IsMissingSpec"
                },
                {
                  "$ref": "#/$defs/EqualsSpec"
                },
                {
                  "$ref": "#/$defs/RowAggregateSpec"
                },
                {
                  "$ref": "#/$defs/ConcatCategoriesSpec"
                },
                {
                  "$ref": "#/$defs/GroupStatSpec"
                },
                {
                  "$ref": "#/$defs/GroupCountSpec"
                },
                {
                  "$ref": "#/$defs/DateDiffSpec"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spec"
        },
        "status": {
          "enum": [
            "active",
            "failed",
            "degenerate",
            "rejected_static"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "source",
        "iteration",
        "status"
      ],
      "title": "FeatureProvenance",
      "type": "object"
    },
