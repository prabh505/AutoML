{
  "$defs": {
    "EventType": {
      "description": "Closed catalog of run event types (PI-31). Prompts that add events extend this enum.",
      "enum": [
        "stage_started",
        "stage_completed",
        "stage_failed",
        "stage_skipped",
        "warning_raised",
        "plan_received",
        "plan_validated",
        "planner_fallback",
        "feature_failed",
        "candidate_started",
        "candidate_completed",
        "candidate_failed",
        "trial_completed",
        "leaderboard_updated",
        "reflection_proposed",
        "reflection_decided",
        "reflection_skipped",
        "ensemble_decided",
        "selection_frozen",
        "holdout_evaluated",
        "explanation_fallback",
        "report_rendered",
        "bundle_exported",
        "llm_call_started",
        "llm_call_succeeded",
        "llm_call_failed",
        "llm_fallback",
        "llm_unavailable",
        "llm_rationale",
        "resource_warning",
        "budget_exhausted",
        "run_completed",
        "run_failed",
        "run_cancelled"
      ],
      "title": "EventType",
      "type": "string"
    },
    "JsonValue": {},
    "Stage": {
      "description": "Run stages and graph nodes used for events, timings, and errors (PRD §13.2, §13.4).",
      "enum": [
        "run",
        "ingest",
        "split",
        "profile",
        "plan",
        "validate_plan",
        "build_features",
        "train_candidates",
        "evaluate",
        "reflect",
        "apply_changes",
        "ensemble",
        "finalize",
        "explain",
        "report",
        "export",
        "recover"
      ],
      "title": "Stage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One progress event (`event/1.0`, PRD §26.13).\n\nEmitted only by the code that performed the action (§27.4). LLM text is carried only with\n`origin = \"llm_rationale\"`.",
  "properties": {
    "data": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Data",
      "type": "object"
    },
    "origin": {
      "default": "system",
      "enum": [
        "system",
        "llm_rationale"
      ],
      "title": "Origin",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "event/1.0",
      "default": "event/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seq": {
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "stage": {
      "$ref": "#/$defs/Stage"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/EventType"
    }
  },
  "required": [
    "run_id",
    "seq",
    "ts",
    "stage",
    "type"
  ],
  "title": "RunEvent",
  "type": "object",
  "x-schema-version": "event/1.0"
}
