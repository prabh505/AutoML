{
  "$defs": {
    "Direction": {
      "description": "Metric optimization direction (PRD §10.4).",
      "enum": [
        "maximize",
        "minimize"
      ],
      "title": "Direction",
      "type": "string"
    },
    "MetricName": {
      "description": "Metric names (PRD §10.2).",
      "enum": [
        "roc_auc",
        "average_precision",
        "log_loss",
        "brier",
        "accuracy",
        "f1",
        "macro_f1",
        "balanced_accuracy",
        "ovr_macro_roc_auc",
        "rmse",
        "mae",
        "rmsle",
        "r2"
      ],
      "title": "MetricName",
      "type": "string"
    },
    "MetricSpec": {
      "additionalProperties": false,
      "description": "A metric and its direction (`metric_spec/1.0`, PRD §10.2, §10.4).",
      "properties": {
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "name": {
          "$ref": "#/$defs/MetricName"
        },
        "schema_version": {
          "const": "metric_spec/1.0",
          "default": "metric_spec/1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "direction"
      ],
      "title": "MetricSpec",
      "type": "object"
    },
    "ModelName": {
      "description": "Model zoo entries (PRD §16.1).",
      "enum": [
        "linear",
        "random_forest",
        "lightgbm",
        "xgboost",
        "catboost",
        "hist_gb"
      ],
      "title": "ModelName",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One leaderboard row (`leaderboard_entry/1.0`, PRD §18.1).\n\n`mean`, `std` (ddof=1) and `sem` must equal the values recomputed from `fold_scores`\n(G-09 / T-EVL-01).",
  "properties": {
    "change_set_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Change Set Id"
    },
    "comparable": {
      "title": "Comparable",
      "type": "boolean"
    },
    "entry_id": {
      "pattern": "^[0-2]-[a-z_]+-[0-9a-f]{8}$",
      "title": "Entry Id",
      "type": "string"
    },
    "experiment_id": {
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Experiment Id",
      "type": "string"
    },
    "feature_set": {
      "enum": [
        "baseline",
        "baseline+llm",
        "ensemble"
      ],
      "title": "Feature Set",
      "type": "string"
    },
    "fit_seconds": {
      "default": 0.0,
      "minimum": 0.0,
      "title": "Fit Seconds",
      "type": "number"
    },
    "fold_scores": {
      "items": {
        "type": "number"
      },
      "title": "Fold Scores",
      "type": "array"
    },
    "iteration": {
      "maximum": 2,
      "minimum": 0,
      "title": "Iteration",
      "type": "integer"
    },
    "mean": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mean"
    },
    "metric": {
      "$ref": "#/$defs/MetricSpec"
    },
    "model": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelName"
        },
        {
          "const": "ensemble",
          "type": "string"
        }
      ],
      "title": "Model"
    },
    "model_size_bytes": {
      "default": 0,
      "minimum": 0,
      "title": "Model Size Bytes",
      "type": "integer"
    },
    "n_features_out": {
      "default": 0,
      "minimum": 0,
      "title": "N Features Out",
      "type": "integer"
    },
    "params": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Params",
      "type": "object"
    },
    "parent_entry_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Entry Id"
    },
    "predict_seconds": {
      "default": 0.0,
      "minimum": 0.0,
      "title": "Predict Seconds",
      "type": "number"
    },
    "schema_version": {
      "const": "leaderboard_entry/1.0",
      "default": "leaderboard_entry/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "secondary": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "$ref": "#/$defs/MetricName"
      },
      "title": "Secondary",
      "type": "object"
    },
    "sem": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sem"
    },
    "split_id": {
      "minLength": 1,
      "title": "Split Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "failed",
        "skipped_resource",
        "skipped_budget"
      ],
      "title": "Status",
      "type": "string"
    },
    "std": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Std"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "entry_id",
    "experiment_id",
    "iteration",
    "model",
    "feature_set",
    "metric",
    "status",
    "comparable",
    "split_id"
  ],
  "title": "LeaderboardEntry",
  "type": "object",
  "x-schema-version": "leaderboard_entry/1.0"
}
