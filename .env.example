# Copy to .env for local development. Never commit .env.
# Execution profile: hosted | local
TABPILOT_PROFILE=local
TABPILOT_DATA_DIR=
# LLM providers (all optional; without keys TabPilot runs rule-based).
GROQ_API_KEY=
TABPILOT_GROQ_MODEL=
TABPILOT_GROQ_CTX=
GEMINI_API_KEY=
TABPILOT_GEMINI_MODEL=
OPENROUTER_API_KEY=
TABPILOT_OR_MODEL_1=
TABPILOT_OR_MODEL_2=
TABPILOT_OLLAMA_MODEL=
